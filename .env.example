# Database Connection String (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/ega_db?schema=public"

# NextAuth / Auth.js Configuration
# Generate a secure key using: openssl rand -base64 32
AUTH_SECRET="your-32-character-secret-key-goes-here"
NEXTAUTH_URL="https://yourdomain.com"

# Payment Gateways (Optional / Stripe)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Email Notifications (SMTP / Brevo / Sendgrid)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-login"
SMTP_PASS="your-smtp-password"
SMTP_FROM="no-reply@yourdomain.com"
