# Database Configuration (PostgreSQL)
# Option 1 (If using the Docker db container from docker-compose.yml):
DATABASE_URL="postgresql://ega_user:ega_password_secure123@db:5432/ega_database?schema=public"
DB_USER="ega_user"
DB_PASSWORD="ega_password_secure123"
DB_NAME="ega_database"

# Option 2 (If using CloudPanel's built-in PostgreSQL or external cloud DB):
# DATABASE_URL="postgresql://cp_user:cp_pass@127.0.0.1:5432/cp_database?schema=public"

# NextAuth / Auth.js Configuration
# Generate a secure key using: openssl rand -base64 32
AUTH_SECRET="your-32-character-secret-key-goes-here"
NEXTAUTH_URL="https://yourdomain.com"

# Payment Gateways (Optional / Stripe)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Email Notifications (SMTP / Brevo / Sendgrid)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-login"
SMTP_PASS="your-smtp-password"
SMTP_FROM="no-reply@yourdomain.com"
